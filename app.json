{
  "expo": {
    "name": "Ustyle",
    "slug": "ustyle",
    "icon": "./assets/app-icon.png",
    "splash": {
      "image": "./assets/images/logo.png",
      "backgroundColor": "#FFFFFF",
      "resizeMode": "contain"
    },
    "plugins": [
      "./plugins/withAndroidPortability",
      "@react-native-firebase/app",
      "@react-native-firebase/analytics",
      "@react-native-firebase/crashlytics",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static",
            "forceStaticLinking": [
              "RNFBApp",
              "RNFBAnalytics",
              "RNFBCrashlytics"
            ]
          }
        }
      ]
    ],
    "version": "1.0.1",
    "android": {
      "package": "com.pbell.ustyle.dev",
      "versionCode": 25,
      "googleServicesFile": "./google-services.json",
      "softwareKeyboardLayoutMode": "pan",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-app-icon.png",
        "backgroundColor": "#FFFFFF"
      }
    },
    "ios": {
      "icon": "./assets/app-icon.png",
      "bundleIdentifier": "com.pbell.ustyle.dev",
      "buildNumber": "34",
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "NSCameraUsageDescription": "This app requires camera access to take photos of your clothing items and profile pictures.",
        "NSPhotoLibraryUsageDescription": "This app requires photo library access to choose images of your clothing items.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "extra": {
      "eas": {
        "projectId": "cab39d61-f33d-43e6-934f-42144f02e499"
      }
    },
    "owner": "rajuan.official.mail"
  }
}
