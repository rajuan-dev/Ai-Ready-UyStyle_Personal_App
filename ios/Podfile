# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "expo/scripts/autolinking.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

# React Native Firebase Swift pods require frameworks on iOS.
$RNFirebaseAsStaticFramework = true

target 'Personal_stylist_app' do
  use_frameworks! :linkage => :static if linkage.nil?
  use_expo_modules!
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    # Xcode 16+ surfaces deprecated Apple API usage inside some third-party pods.
    # Those warnings can break remote EAS builds depending on the toolchain.
    installer.pods_project.targets.each do |target|
      next unless ['RNFBStorage'].include?(target.name)

      target.build_configurations.each do |build_configuration|
        warning_flags = build_configuration.build_settings['WARNING_CFLAGS'] || ['$(inherited)']
        warning_flags = [warning_flags] unless warning_flags.is_a?(Array)

        unless warning_flags.include?('-Wno-deprecated-declarations')
          warning_flags << '-Wno-deprecated-declarations'
        end

        build_configuration.build_settings['WARNING_CFLAGS'] = warning_flags
      end
    end
  end
end
